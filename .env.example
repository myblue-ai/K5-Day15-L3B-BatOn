# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả. Bản thử hỗ trợ deepinfra và openai.
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
# Chỉ điền khi dùng nhà cung cấp trung gian theo chuẩn OpenAI (để trống = gọi thẳng api.openai.com).
OPENAI_BASE_URL=
# Gateway HTTPS bổ sung được trang quản trị cho phép, phân cách bằng dấu phẩy. Ví dụ: https://gateway.example/v1
MODEL_ALLOWED_BASE_URLS=

# Bỏ dấu # ở bốn dòng dưới để chạy chat và admin bằng Python trên máy local.
# BIND_HOST=127.0.0.1
# PORT=8091
# ADMIN_PORT=8092
# MODEL_CONFIG_DIR=runtime-config/local
